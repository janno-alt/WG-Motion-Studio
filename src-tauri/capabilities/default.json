{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability — everything the single-user local app needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "shell:default",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/ffmpeg", "sidecar": true, "args": true },
        { "name": "binaries/ffprobe", "sidecar": true, "args": true },
        { "name": "binaries/whisper", "sidecar": true, "args": true }
      ]
    }
  ]
}
