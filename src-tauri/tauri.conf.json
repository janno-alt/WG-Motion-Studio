{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WG Motion Studio",
  "version": "0.0.1",
  "identifier": "com.wgdigital.motionstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WG Motion Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "backgroundColor": "#0B0C0F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
